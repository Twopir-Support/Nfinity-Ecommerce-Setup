<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>NFT_Line_Status__c</fullName>
<formula>IF(NFT_Qty_Shipped__c &gt;= Quantity, "Shipped", IF(NFT_Qty_Shipped__c &gt; 0, "Partially Shipped", IF(NFT_Qty_Confirmed__c &gt; 0, "Confirmed", "Pending")))</formula>
<formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
<label>Line Status</label>
<type>Text</type>
</CustomField>
